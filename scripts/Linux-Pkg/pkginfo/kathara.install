post_install() {
    if [ $(getent group docker) ]; then
        chown root:docker /usr/lib/kathara/kathara
    fi
    chmod g+s /usr/lib/kathara/kathara
    chgrp --reference=/usr/lib/kathara/kathara /usr/lib/kathara/_internal
}

pre_remove() {
    /usr/lib/kathara/kathara wipe -f -a &> /dev/null || true
}
