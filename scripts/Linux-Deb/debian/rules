#!/usr/bin/make -f

%:
	dh $@ --with bash-completion

override_dh_auto_clean:
	rm -rf kathara.build
	rm -rf kathara.dist
	find . | grep -E "(__pycache__|\.pyc|\.pyo)$$" | xargs rm -rf

override_dh_auto_configure:
	python3.14 -m venv $(CURDIR)/venv
	$(CURDIR)/venv/bin/python3.14 -m pip install -r $(CURDIR)/requirements.txt
	$(CURDIR)/venv/bin/python3.14 -m pip install pyinstaller

override_dh_auto_build:
	$(CURDIR)/venv/bin/pyinstaller --distpath=./kathara.dist --workpath=./kathara.build kathara.spec

override_dh_auto_install:
	rm -rf $(CURDIR)/debian/kathara/usr/lib/kathara/*
	cp -r $(CURDIR)/kathara.dist/kathara/* $(CURDIR)/debian/kathara/usr/lib/kathara/
	chmod 400 $(CURDIR)/debian/kathara/usr/lib/kathara/_internal/*.so*
	chmod 755 $(CURDIR)/debian/kathara/usr/lib/kathara/kathara

override_dh_strip:
	rm  -f $(CURDIR)/debian/kathara/usr/lib/kathara/*libbz2.so.1.0
	rm  -f $(CURDIR)/debian/kathara/usr/lib/kathara/*libexpat.so.1
	rm  -f $(CURDIR)/debian/kathara/usr/lib/kathara/*libtinfo.so.6
	rm  -f $(CURDIR)/debian/kathara/usr/lib/kathara/*libz.so.1
	rm  -f $(CURDIR)/debian/kathara/usr/lib/kathara/*libtinfo.so.5
	rm  -f $(CURDIR)/debian/kathara/usr/lib/kathara/*libcrypto.so.1.1
	rm -rf $(CURDIR)/venv
